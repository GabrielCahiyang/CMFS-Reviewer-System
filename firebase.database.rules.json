{
  "rules": {
    "cfms": {
      ".read": false,
      ".write": false,
      "categories": {
        ".read": "auth != null",
        ".write": false,
        "$categoryId": {
          ".validate": "newData.hasChildren(['title', 'description', 'sourceDocument', 'icon', 'color', 'questionCount', 'types', 'enabledModes']) && ($categoryId === 'new-reviewer' || $categoryId === 'cfms-questionnaire' || $categoryId === 'huhuhuhu-reviewer' || $categoryId === 'pre-finals' || $categoryId === 'working-capital' || $categoryId === 'financial-statements')",
          "title": {
            ".validate": "newData.isString() && (newData.val() === 'NEW REVIEWER' || newData.val() === 'CFMS Questionnaire' || newData.val() === 'HUHUHUHU Reviewer' || newData.val() === 'Pre-Finals Practice & Recitation' || newData.val() === 'Working Capital & Cash Management' || newData.val() === 'Financial Statements Fundamentals')"
          },
          "description": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "sourceDocument": {
            ".validate": "newData.isString()"
          },
          "icon": {
            ".validate": "newData.isString()"
          },
          "color": {
            ".validate": "newData.isString()"
          },
          "questionCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "expectedCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "types": {
            "$index": {
              ".validate": "newData.val() === 'multiple-choice' || newData.val() === 'true-false' || newData.val() === 'identification' || newData.val() === 'enumeration'"
            }
          },
          "enabledModes": {
            "$index": {
              ".validate": "newData.val() === 'practice' || newData.val() === 'exam' || newData.val() === 'flashcard' || newData.val() === 'mixed'"
            }
          },
          "$other": {
            ".validate": false
          },
          "contentVersion": {
            ".validate": "newData.isString()"
          }
        }
      },
      "questions": {
        ".read": "auth != null",
        ".write": false,
        "$categoryId": {
          "$questionId": {
            ".validate": "newData.hasChildren(['originalNumber', 'question', 'type', 'correctAnswer', 'sourceDocument', 'verificationStatus', 'topic'])",
            "question": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30000"
            },
            "originalNumber": {
              ".validate": "newData.isString()"
            },
            "type": {
              ".validate": "newData.val() === 'multiple-choice' || newData.val() === 'true-false' || newData.val() === 'identification' || newData.val() === 'enumeration'"
            },
            "verificationStatus": {
              ".validate": "newData.val() === 'verified' || newData.val() === 'review-required'"
            },
            "derived": {
              ".validate": "newData.isBoolean()"
            },
            "sourceDocument": {
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "sourcePage": {
              ".validate": "newData.isString()"
            },
            "topic": {
              ".validate": "newData.isString()"
            },
            "explanation": {
              ".validate": "newData.isString()"
            },
            "formula": {
              ".validate": "newData.isString()"
            },
            "orderMatters": {
              ".validate": "newData.isBoolean()"
            },
            "choices": {
              "$index": {
                ".validate": "newData.isString()"
              }
            },
            "acceptedAnswers": {
              "$index": {
                ".validate": "newData.isString()"
              }
            },
            "alternatives": {
              "$answer": {
                "$index": {
                  ".validate": "newData.isString()"
                }
              }
            },
            "correctAnswer": {
              ".validate": "newData.isString() || newData.hasChildren()",
              "$index": {
                ".validate": "newData.isString()"
              }
            },
            "$other": {
              ".validate": false
            },
            "originalAnswerLetter": {
              ".validate": "newData.isString()"
            },
            "contentVersion": {
              ".validate": "newData.isString()"
            },
            "importId": {
              ".validate": "newData.isString()"
            },
            "reviewedBy": {
              ".validate": "newData.isString()"
            }
          }
        }
      },
      "users": {
        "$uid": {
          "profile": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['displayName', 'email', 'createdAt', 'updatedAt'])",
            "displayName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "email": {
              ".validate": "newData.isString() && newData.val() === auth.token.email"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            },
            ".read": "auth != null && auth.uid === $uid"
          },
          "preferences": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['theme', 'defaultStudyMode', 'instantFeedback', 'showExplanations'])",
            "theme": {
              ".validate": "newData.val() === 'light' || newData.val() === 'dark'"
            },
            "defaultStudyMode": {
              ".validate": "newData.val() === 'practice' || newData.val() === 'exam' || newData.val() === 'flashcard' || newData.val() === 'mixed'"
            },
            "instantFeedback": {
              ".validate": "newData.isBoolean()"
            },
            "showExplanations": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            },
            ".read": "auth != null && auth.uid === $uid"
          },
          "sessions": {
            "$sessionId": {
              ".write": false,
              ".validate": "newData.hasChildren(['id', 'categoryId', 'mode', 'settings', 'questionIds', 'currentQuestionIndex', 'status', 'startedAt', 'updatedAt', 'revision']) && newData.child('id').val() === $sessionId && ((!data.exists() && newData.child('revision').val() === 1) || (data.exists() && newData.child('revision').val() === data.child('revision').val() + 1)) && (!data.exists() || newData.child('contentVersion').val() === data.child('contentVersion').val())",
              "id": {
                ".validate": "newData.isString()"
              },
              "categoryId": {
                ".validate": "newData.isString() && root.child('cfms/categories').child(newData.val()).exists() && (!data.exists() || data.val() === newData.val())"
              },
              "mode": {
                ".validate": "newData.val() === 'practice' || newData.val() === 'exam' || newData.val() === 'flashcard' || newData.val() === 'mixed' && (!data.exists() || data.val() === newData.val())"
              },
              "questionIds": {
                "$index": {
                  ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
                },
                ".validate": "newData.hasChildren()"
              },
              "currentQuestionIndex": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000"
              },
              "status": {
                ".validate": "newData.val() === 'in-progress' || newData.val() === 'completed'"
              },
              "startedAt": {
                ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
              },
              "updatedAt": {
                ".validate": "newData.isNumber()"
              },
              "completedAt": {
                ".validate": "newData.isNumber()"
              },
              "revision": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "choiceOrder": {
                "$questionId": {
                  "$index": {
                    ".validate": "newData.isString()"
                  }
                }
              },
              "answers": {
                "$questionId": {
                  ".validate": "newData.hasChildren(['value', 'status', 'credit', 'graded'])",
                  "value": {
                    ".validate": "newData.isString() || newData.hasChildren()",
                    "$index": {
                      ".validate": "newData.isString()"
                    }
                  },
                  "status": {
                    ".validate": "newData.val() === 'pending' || newData.val() === 'correct' || newData.val() === 'incorrect' || newData.val() === 'partial' || newData.val() === 'skipped' || newData.val() === 'review-required'"
                  },
                  "credit": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                  },
                  "graded": {
                    ".validate": "newData.isBoolean()"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "settings": {
                ".validate": "newData.hasChildren(['mode', 'types', 'count', 'randomize', 'shuffleChoices', 'instantFeedback', 'showExplanations', 'timer', 'durationMinutes', 'filter'])",
                "mode": {
                  ".validate": "newData.val() === 'practice' || newData.val() === 'exam' || newData.val() === 'flashcard' || newData.val() === 'mixed' && (!data.exists() || data.val() === newData.val())"
                },
                "types": {
                  "$index": {
                    ".validate": "newData.val() === 'multiple-choice' || newData.val() === 'true-false' || newData.val() === 'identification' || newData.val() === 'enumeration' && (!data.exists() || data.val() === newData.val())"
                  }
                },
                "count": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000 && (!data.exists() || data.val() === newData.val())"
                },
                "randomize": {
                  ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())"
                },
                "shuffleChoices": {
                  ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())"
                },
                "instantFeedback": {
                  ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())"
                },
                "showExplanations": {
                  ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())"
                },
                "timer": {
                  ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())"
                },
                "durationMinutes": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 180 && (!data.exists() || data.val() === newData.val())"
                },
                "filter": {
                  ".validate": "newData.val() === 'all' || newData.val() === 'unanswered' || newData.val() === 'bookmarked' || newData.val() === 'incorrect' && (!data.exists() || data.val() === newData.val())"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              },
              "contentVersion": {
                ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
              }
            },
            ".read": "auth != null && auth.uid === $uid",
            ".indexOn": [
              "updatedAt"
            ]
          },
          "bookmarks": {
            "$categoryId": {
              "$questionId": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.val() === true"
              }
            },
            ".read": "auth != null && auth.uid === $uid"
          },
          "flashcardProgress": {
            "$categoryId": {
              "$questionId": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.hasChildren(['status', 'lastReviewedAt'])",
                "status": {
                  ".validate": "newData.val() === 'known' || newData.val() === 'again'"
                },
                "lastReviewedAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            ".read": "auth != null && auth.uid === $uid"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "questionBankVersions": {
        ".read": "auth != null",
        ".write": false
      },
      "sourceImports": {
        ".read": "auth != null && auth.token.cfmsAdmin === true",
        ".write": false,
        ".indexOn": [
          "appliedAt"
        ]
      },
      "activityEvents": {
        ".read": "auth != null && auth.token.cfmsAdmin === true",
        ".write": false,
        ".indexOn": [
          "occurredAt",
          "uid",
          "categoryId",
          "type"
        ]
      },
      "analytics": {
        ".read": "auth != null && auth.token.cfmsAdmin === true",
        ".write": false,
        "scores": {
          "$uid": {
            ".indexOn": [
              "completedAt"
            ]
          }
        }
      },
      "admin": {
        ".read": "auth != null && auth.token.cfmsAdmin === true",
        ".write": false
      }
    }
  }
}
